# ─────────────────────────────────────────────
# Meta WhatsApp Cloud API Credentials
# Get from: https://developers.facebook.com/apps/
# ─────────────────────────────────────────────

# Your permanent System User Access Token
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phone Number ID (numeric, from API Setup page)
META_PHONE_NUMBER_ID=1234567890123456

# WhatsApp Business Account ID (WABA ID)
META_WABA_ID=1234567890123456

# Meta App ID and Secret (for webhook verification)
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret

# Webhook verify token (you set this in Meta Dashboard > Webhooks)
WEBHOOK_VERIFY_TOKEN=my_secure_verify_token_123

# ─────────────────────────────────────────────
# Server Config
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/wa-platform

# Secret key to protect your API endpoints
API_SECRET_KEY=change_this_to_a_long_random_string_min_32_chars

# ─────────────────────────────────────────────
# Optional: Public URL (used for webhook display)
# Set this to your ngrok/server URL
# ─────────────────────────────────────────────
PUBLIC_URL=https://yourdomain.com
